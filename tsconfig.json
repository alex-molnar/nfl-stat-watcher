{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true, // the collector runs under Node, which strips the types and needs the extension
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node", "vite/client"]
  },
  "include": ["src", "collector", "vite.config.ts"]
}
