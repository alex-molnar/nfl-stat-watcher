          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(increase(statwatch_league_import_total{namespace=\"$namespace\",transport!=\"public-api\"}[$__range])) / sum(increase(statwatch_league_load_total{namespace=\"$namespace\",result=\"private\"}[$__range]))",
