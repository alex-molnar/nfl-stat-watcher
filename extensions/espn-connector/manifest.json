{
  "manifest_version": 3,
  "name": "Stat Watch ESPN Connector (development)",
  "version": "0.1.0",
  "description": "Reads ESPN fantasy settings for Stat Watch after a user starts an import.",
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "externally_connectable": { "matches": ["http://localhost:5173/*"] }
}
